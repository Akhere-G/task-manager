# Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
# Path to the database provider's CA certificate. When set, connections use TLS with verification.
DB_SSL_CA=

# Server (only used when running app/main.py directly)
FLASK_RUN_HOST=
FLASK_RUN_PORT=

# Auth. Cookies are Secure unless JWT_COOKIE_SECURE=False (set that for local http).
# JWT_COOKIE_SAMESITE defaults to Lax; use None only if the frontend is served from another site.
JWT_SECRET_KEY=
JWT_COOKIE_SECURE=
JWT_COOKIE_SAMESITE=

# Public URL of the frontend, used for CORS and password-reset links (no trailing slash)
FRONTEND_URL=

# Email (MailerSend): password reset and contact form
MAIL_SEND_API_KEY=
MAIL_SEND_EMAIL=
# Address that receives contact-form enquiries (MAIL_USERNAME is the older name and still works)
CONTACT_TO_EMAIL=
MAIL_USERNAME=

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides
GEMINI_MODEL=
GROQ_MODEL=

# Web push (reminders job)
VAPID_PRIVATE_KEY=

# Rate limiting: Redis keeps request counts shared between instances (in-memory if unset)
REDIS_URL=
# Number of reverse proxies in front of the app (1 on Cloud Run) so the real client IP is used
TRUSTED_PROXY_HOPS=
